  },
  "links": [
    {
      "domains": [
        "tracking.dpd.hk"
      ],
      "pathPattern": "^/?$",
      "params": [
        "trackNo",
        "trackingNumber"
      ],
      "fragment": "^/\\?(?:[^#]*&)?(?:trackNo|trackingNumber)=([^&]+)"
    }
  ],
  "detection": []
}
