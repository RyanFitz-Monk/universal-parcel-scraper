    "discarded": [],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "track.gfsxpress.com"
      ],
      "pathPattern": "^/?$",
      "fragment": "^/track-order\\?trackingStr=([A-Za-z0-9-]+)$"
    }
  ],
  "detection": []
}
