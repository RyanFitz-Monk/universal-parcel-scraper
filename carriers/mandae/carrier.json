{
  "id": "mandae",
  "displayName": "Mandaê",
  "aliases": [
    "Mandae",
    "Nuvem Envio/Mandaê",
    "Rastreaê"
  ],
  "region": {
    "countries": [
      "BR"
    ]
  },
  "brand": {
    "color": "#0050c3"
  },
  "selectable": true,
  "timezone": "America/Sao_Paulo",
  "tracking": {
    "mode": "automatic",
    "adapter": "mandae",
    "steps": [
      "trawl"
    ],
    "browser": true
  },
  "capabilities": [
    "history",
    "eta",
    "offset_timestamps",
    "canonical_tracking_number"
  ],
  "portal": {
    "url": "https://rastreae.com.br/resultado/{trackingNumber}",
    "searchUrl": "https://rastreae.com.br/busca",
    "canaryUrl": "https://rastreae.com.br/busca",
    "shows": [
      "status",
      "history",
      "eta",
      "offset_timestamps",
      "delivery_partner",
      "progress_rail",
      "canonical_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "eta",
      "offset_timestamps",
      "canonical_tracking_number"
    ],
    "discarded": [
      "delivery_partner",
      "progress_rail"
    ],
    "unavailable": [
      "location",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "rastreae.com.br"
      ],
      "path": "^/resultado/([A-Za-z0-9]+)/?$"
    },
    {
      "domains": [
        "app.mandae.com.br"
      ],
      "path": "^/rastreamento/([A-Za-z0-9]+)/?$"
    }
  ],
  "detection": []
}
